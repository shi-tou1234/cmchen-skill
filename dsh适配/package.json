{
  "name": "cmchen-skills",
  "version": "0.1.0",
  "description": "DSH bundle that packages the cmchen personal skills (11 skills) for DeepSeek Harness",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "skills.metadata.json",
    "cordis.patch.yml",
    "skills/**",
    "README.md"
  ],
  "scripts": {
    "extract": "node extract-descriptions.mjs",
    "test": "node --check index.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-skill": ">=0.1.0-rc.5"
  },
  "license": "MIT"
}
